@top Script { Assignment* }

Assignment { Key Operator Value }

Key { Identifier | StringValue | NumberValue | SymbolValue }

Operator {
  Equals | LessEq | LessThan | GreaterEq | GreaterThan | NotEqual
}

Value {
  StringValue
  | DateValue
  | NumberValue
  | BooleanValue
  | Identifier
  | Block
  | BracketExpression
  | SymbolValue
}

Block { LBrace BlockItem* RBrace }

BlockItem { Assignment | Value }

BooleanValue { @specialize<Identifier, "yes" | "no"> }

BracketExpression { BracketExprToken }

@dialects { hoi4_bracket_expr }

@skip { whitespace | Comment }

@tokens {
  // The `@` is a legal interior identifier character: `variable@token` (runtime
  // dynamic indexing, e.g. `ai_variant_level@fighter_equipment`) is ONE token.
  // The sigil is only significant in leading position, where SymbolValue claims
  // it — Identifier never starts with `@`, so the two never collide.
  Identifier { $[A-Za-z_] $[A-Za-z0-9_@]* }

  // A substitution constant, in definition (`@NAME = …`, key position) and
  // reference (`… = @NAME`, value position) forms. NAME is one-or-more
  // name characters after a leading `@`; it may be numeric (`@1933`) or
  // alphanumeric with underscores (`@FTR_START`). `@[` cannot match (the next
  // char is `[`, not a name char), so BracketExprToken keeps `@[ expr ]`.
  SymbolValue { "@" $[A-Za-z0-9_]+ }

  StringValue { '"' ( !["\\] | "\\" _ )* '"' }

  DateValue  { $[0-9]+ "." $[0-9]+ "." $[0-9]+ }
  NumberValue { "-"? $[0-9]+ ("." $[0-9]+)? }

  LBrace      { "{" }
  RBrace      { "}" }

  Equals      { "=" }
  LessEq      { "<=" }
  LessThan    { "<" }
  GreaterEq   { ">=" }
  GreaterThan { ">" }
  NotEqual    { "!=" }

  Comment { "#" ![\n]* }

  BracketExprToken[@dialect=hoi4_bracket_expr] { "@[" ![\]]* "]" }

  whitespace { $[ \t\r\n]+ }

  @precedence { DateValue, NumberValue }
  @precedence { LessEq, LessThan }
  @precedence { GreaterEq, GreaterThan }
}
