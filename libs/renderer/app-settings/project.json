{
  "name": "renderer-app-settings",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/renderer/app-settings/src",
  "prefix": "zmt",
  "projectType": "library",
  "tags": ["type:domain", "scope:renderer"],
  "targets": {
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@angular/build:unit-test",
      "options": {
        "buildTarget": "renderer:build:development",
        "tsConfig": "libs/renderer/app-settings/tsconfig.spec.json",
        "runner": "vitest",
        "watch": false,
        "coverage": true,
        "coverageReporters": ["text-summary"],
        "coverageThresholds": {
          "branches": 80,
          "functions": 80,
          "lines": 80,
          "statements": 80
        },
        "coverageInclude": ["libs/renderer/app-settings/src/**/*.ts"],
        "coverageExclude": ["libs/renderer/app-settings/src/**/*.spec.ts"]
      },
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"]
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "ngc -p libs/renderer/app-settings/tsconfig.lib.json --noEmit",
          "tsc -p libs/renderer/app-settings/tsconfig.spec.json --noEmit"
        ],
        "parallel": false
      }
    },
    "mutation": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "stryker run libs/renderer/app-settings/stryker.config.mjs"
      }
    }
  }
}
