{
  "name": "renderer-entity-form-ui",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/renderer/entity-form/ui/src",
  "prefix": "zmt",
  "projectType": "library",
  "tags": ["type:ui", "scope:renderer"],
  "targets": {
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@angular/build:unit-test",
      "options": {
        "buildTarget": "renderer:build:development",
        "tsConfig": "libs/renderer/entity-form/ui/tsconfig.spec.json",
        "runner": "vitest",
        "watch": false,
        "coverage": true,
        "coverageReporters": ["text-summary"],
        "coverageThresholds": {
          "branches": 80,
          "functions": 80,
          "lines": 80,
          "statements": 80
        },
        "coverageInclude": ["libs/renderer/entity-form/ui/src/**/*.ts"],
        "coverageExclude": ["libs/renderer/entity-form/ui/src/**/*.spec.ts"]
      },
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"]
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "ngc -p libs/renderer/entity-form/ui/tsconfig.lib.json --noEmit",
          "tsc -p libs/renderer/entity-form/ui/tsconfig.spec.json --noEmit"
        ],
        "parallel": false
      }
    }
  }
}
