{
  "name": "shared-i18n",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/shared/i18n/src",
  "projectType": "library",
  "tags": ["type:util", "scope:shared"],
  "targets": {
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["default", "^production"],
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "command": "vitest run --coverage",
        "cwd": "libs/shared/i18n"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "tsc -p libs/shared/i18n/tsconfig.lib.json --noEmit",
          "tsc -p libs/shared/i18n/tsconfig.spec.json --noEmit"
        ],
        "parallel": false
      }
    },
    "typecheck-negative": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/scripts/expect-typecheck-failure.mjs libs/shared/i18n/tsconfig.fixtures.json"
      }
    },
    "mutation": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "stryker run libs/shared/i18n/stryker.config.mjs"
      }
    }
  }
}
