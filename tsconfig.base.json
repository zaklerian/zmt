{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "target": "es2022",
    "module": "preserve",
    "moduleResolution": "bundler",
    "lib": ["es2024", "dom", "dom.iterable"],
    "types": [],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noPropertyAccessFromIndexSignature": true,
    "verbatimModuleSyntax": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "sourceMap": true,
    "declaration": false,
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "paths": {
      "@zmt/contracts": ["./libs/contracts/src/index.ts"],
      "@zmt/renderer/app-settings/data-access": [
        "./libs/renderer/app-settings/src/data-access/index.ts"
      ],
      "@zmt/renderer/app-settings/feature": ["./libs/renderer/app-settings/src/feature/index.ts"],
      "@zmt/renderer/app-settings/ui": ["./libs/renderer/app-settings/src/ui/index.ts"],
      "@zmt/renderer/app-settings/util": ["./libs/renderer/app-settings/src/util/index.ts"],
      "@zmt/renderer/core": ["./libs/renderer/core/src/index.ts"],
      "@zmt/renderer/home/feature": ["./libs/renderer/home/src/feature/index.ts"],
      "@zmt/renderer/mod-content/data-access": [
        "./libs/renderer/mod-content/src/data-access/index.ts"
      ],
      "@zmt/renderer/mod-content/feature": ["./libs/renderer/mod-content/src/feature/index.ts"],
      "@zmt/renderer/mod-content/ui": ["./libs/renderer/mod-content/src/ui/index.ts"],
      "@zmt/renderer/mod-content/util": ["./libs/renderer/mod-content/src/util/index.ts"],
      "@zmt/renderer/mod-info/data-access": ["./libs/renderer/mod-info/src/data-access/index.ts"],
      "@zmt/renderer/mod-info/feature": ["./libs/renderer/mod-info/src/feature/index.ts"],
      "@zmt/renderer/mod-info/ui": ["./libs/renderer/mod-info/src/ui/index.ts"],
      "@zmt/renderer/mod-info/util": ["./libs/renderer/mod-info/src/util/index.ts"],
      "@zmt/renderer/shell/data-access": ["./libs/renderer/shell/src/data-access/index.ts"],
      "@zmt/renderer/shell/feature": ["./libs/renderer/shell/src/feature/index.ts"],
      "@zmt/renderer/shell/ui": ["./libs/renderer/shell/src/ui/index.ts"],
      "@zmt/renderer/tech-tree/data-access": ["./libs/renderer/tech-tree/src/data-access/index.ts"],
      "@zmt/renderer/tech-tree/feature": ["./libs/renderer/tech-tree/src/feature/index.ts"],
      "@zmt/renderer/tech-tree/ui": ["./libs/renderer/tech-tree/src/ui/index.ts"],
      "@zmt/renderer/tech-tree/util": ["./libs/renderer/tech-tree/src/util/index.ts"],
      "@zmt/shared/i18n": ["./libs/shared/i18n/src/index.ts"]
    }
  },
  "angularCompilerOptions": {
    "strictTemplates": true,
    "strictStandalone": true,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true,
    "typeCheckHostBindings": true,
    "extendedDiagnostics": {
      "defaultCategory": "error"
    }
  },
  "exclude": ["node_modules", "tmp", "dist"]
}
